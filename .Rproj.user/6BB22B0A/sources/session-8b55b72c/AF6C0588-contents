```

```{r, warning=FALSE, message=FALSE}
require(raster)
# 5km buffer, units are km
bndwf_buf<-data.frame(buffer(SpatialPolygons(list(
                Polygons(list(Polygon(nysted.bndwf)),ID = 1))), width=5)@
                polygons[[1]]@Polygons[[1]]@coords)
names(bndwf_buf)<-c('x.pos', 'y.pos')
detach(package:raster)
```

2. Fit Spatial Model

Let's start simple by pooling all survey data and using no environmental covariates.

```{r echo=FALSE, eval=FALSE}
# run this code initially to get the model
profout <- tweedie.profile(Count ~ x.pos + y.pos,
                           data=count.data,
                           xi.vec = seq(1.01, 1.99, by=0.05), do.plot=TRUE)

initialModel <- glm(Count ~ 1 + offset(log(Area)),
                    family=tweedie(var.power=profout$xi.max, link.power = 0),
                    data = count.data)

kg <- getKnotgrid(coordData = count.data[,c('x.pos', 'y.pos')], plot=FALSE)

dists <- makeDists(datacoords = count.data[,c('x.pos', 'y.pos')], 
                   knotcoords = kg, 
                   knotmat = TRUE)
k2k <- dists$knotDist
d2k <- dists$dataDist

salsa2dlist<-list(fitnessMeasure = 'BICtweedie', 
                   knotgrid = kg, 
                   startKnots = 5,
                   minKnots=4,  
                   maxKnots=100, 
                   gap=0) 

salsa2dOutput<-runSALSA2D(model = initialModel,
                          salsa2dlist = salsa2dlist,
                          d2k = d2k,
                          k2k = k2k,
                          panels =  count.data$TransectID,
                          suppress.printout = TRUE)

simplemodel <- salsa2dOutput$bestModel

saveRDS(simplemodel, file = "data/simplespatialmodel.rds")
```


